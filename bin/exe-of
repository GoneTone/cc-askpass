#!/bin/sh
# exe-of <pid>: print the path of a process's executable, as the kernel records it, so
# argv[0] cannot fake it. Linux reads /proc; macOS has no /proc, so the first `txt` file
# lsof lists for the process is its executable. Only an existing file counts: lsof puts its
# error for a process it may not read (root's sudo) where the name goes.
exe=$(readlink -f "/proc/$1/exe" 2> /dev/null) && [ -f "$exe" ] ||
  exe=$(lsof -a -p "$1" -d txt -Fn -n -P 2> /dev/null | sed -n 's/^n//p' | head -n 1)
[ -f "$exe" ] || exit 1
printf '%s\n' "$exe"
